modules = ["nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dev server"

[[workflows.workflow]]
name = "Dev server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/poker-dashboard run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

# A static site: no server or database. Publishing builds the files and serves them as-is.
[deployment]
deploymentTarget = "static"
build = ["pnpm", "--filter", "@workspace/poker-dashboard", "run", "build"]
publicDir = "artifacts/poker-dashboard/dist/public"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"
