modules = ["web", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"

[workflows]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24157
externalPort = 3000

# A static site: no server or database. Publishing builds the files and serves them as-is.
[deployment]
deploymentTarget = "static"
build = ["pnpm", "--filter", "@workspace/poker-dashboard", "run", "build"]
publicDir = "artifacts/poker-dashboard/dist/public"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"
